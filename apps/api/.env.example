# Tanong402 API: copy to .env, or run `pnpm --filter @tanong/scripts setup:testnet` to generate testnet values.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5180           # comma-separated; add your web dev URL

# Stellar / x402
NETWORK=stellar:testnet                    # stellar:pubnet in prod
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_API_KEY=                       # mainnet facilitator, if required
PAYMENTS=auto                              # auto = on when SERVER_STELLAR_ADDRESS is set
SERVER_STELLAR_ADDRESS=                    # receiving address (payTo), needs a USDC trustline
PRICE_USDC=0.005
MAX_PRICE_USDC=0.02
PHP_PER_USD=58

# Keys (server-only, never logged or committed)
TREASURY_SECRET=                           # sponsors student accounts, relays pool claims
POOL_ADMIN_SECRET=                         # enroll / pause (falls back to treasury)
POOL_CONTRACT_ID=                          # tanong-pool contract C…

# AI: first provider with a key answers; the rest are backups. No keys at all = canned demo answers.
AI_PRIMARY=openai                          # openai | anthropic | gemini
AI_FALLBACKS=anthropic,gemini
OPENAI_API_KEY=                            # platform.openai.com → API keys
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_QUICK=gpt-5-nano              # short "what is…" questions
OPENAI_MODEL_HARD=gpt-5-mini               # runs at medium reasoning effort
ANTHROPIC_API_KEY=                         # optional backup
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=                            # optional backup
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_HARD=gemini-flash-latest
# Pro tier (POST /ask?tier=pro). Gemini Pro is off by default; at $0.02 it can cost more than it earns.
PRO_PRICE_USDC=0.02
PRO_MAX_OUTPUT_TOKENS=900
OPENAI_MODEL_PRO=gpt-5.4
ANTHROPIC_MODEL_PRO=claude-sonnet-5-5
GEMINI_MODEL_PRO=
GROQ_API_KEY=                              # optional, console.groq.com/keys
GROQ_MODEL_QUICK=llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_HARD=openai/gpt-oss-120b

# Data (leave empty for the in-memory store; Neon pooled URL in prod)
DATABASE_URL=
DATABASE_URL_DIRECT=
JWT_SECRET=

INVITE_CODES=FEU001,FEU002,DEMO42          # dev-only invites when no DB
RATE_LIMIT_ASK_PER_10MIN=30
MAX_DAILY_QUESTIONS=5000
