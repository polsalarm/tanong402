# Tanong402 web app. Everything else (network, price, receiving address, pool) comes from GET /config.
VITE_API_URL=http://localhost:3001

# Optional pins (defence in depth). When set, the app refuses to pay if /config disagrees.
# VITE_NETWORK=stellar:testnet
# VITE_RECEIVER_ADDRESS=G...
# VITE_MAX_PRICE_USDC=0.02

# Standalone demo: answers, balances, receipts and stats come from an in-browser mock.
# VITE_MOCK_API=true
